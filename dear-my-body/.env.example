# Supabase 대시보드 > Project Settings > API (또는 Connect 버튼)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Publishable key (sb_publishable_...). 예전 프로젝트라면 anon public key 를 넣어도 됩니다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# 가입 확인 메일 링크에 쓰일 사이트 주소 (끝에 / 없이). 로컬: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# service role 키는 이 앱에 필요 없습니다. 절대 NEXT_PUBLIC_ 으로 시작하는 변수에 넣지 마세요.
